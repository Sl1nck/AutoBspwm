#! /bin/sh

pgrep -x sxhkd > /dev/null || sxhkd &

bspc monitor -d 1 2 3 4 5

bspc config border_width         2
bspc config window_gap          12

bspc config split_ratio          0.52
bspc config borderless_monocle   true
bspc config gapless_monocle      true

bspc rule -a Gimp desktop='^8' state=floating follow=on
bspc rule -a Chromium desktop='^2'
bspc rule -a mplayer2 state=floating
bspc rule -a Kupfer.py focus=on
bspc rule -a Screenkey manage=off
#cOLORES DE BORDE
bspc config normal_border_color '#313244'
bspc config focused_border_color '#89b4fa'

#Fondo y compositor
xsetroot -solid '#1e1e2e' &
pgrep -x picom > /dev/null || picom &

# Integración con VMware (portapapeles, resolución), solo si está instalada
if command -v vmware-user-suid-wrapper > /dev/null; then
    pgrep -u "$USER" -x vmtoolsd > /dev/null || vmware-user-suid-wrapper &
fi

# Barra superior
pgrep -x polybar > /dev/null || polybar main &
