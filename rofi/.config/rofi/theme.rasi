* {
    bg: #1e1e2e;
    bg-alt: #313244;
    fg: #cdd6f4;
    muted: #6c7086;
    accent: #89b4fa;
    font: "JetBrainsMono Nerd Font 11";
    background-color: transparent;
    text-color: @fg;
}

window {
    width: 480px;
    location: center;
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 12px;
    padding: 12px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 10px;
}

inputbar {
    background-color: @bg-alt;
    border-radius: 8px;
    padding: 8px 12px;
    spacing: 8px;
    children: [ prompt, entry ];
}

prompt { text-color: @accent; }

entry {
    placeholder: "Buscar...";
    placeholder-color: @muted;
}

listview {
    lines: 8;
    columns: 1;
    fixed-height: false;
    scrollbar: false;
    spacing: 4px;
}

element {
    padding: 8px 12px;
    border-radius: 8px;
}

element selected.normal {
    background-color: @accent;
    text-color: @bg;
}

element-text {
    background-color: transparent;
    text-color: inherit;
}
